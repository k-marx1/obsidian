      "styleAttributes": {
        "textAlign": "center"
      },
      "text": "Сократич. диалог",
      "type": "text",
      "width": 260,
      "x": 240,
      "y": -160
    },
    {
      "height": 60,
      "id": "8dde3af89ea43b18",
      "styleAttributes": {
        "textAlign": "center"
      },
      "text": "\"Познай себя самого\"",
      "type": "text",
      "width": 260,
      "x": -600,
      "y": -220
    },
    {
      "height": 60,
      "id": "703e082a2a5d1c3a",
      "styleAttributes": {
        "textAlign": "center"
      },
      "text": "\"Я знаю, что ничего не знаю\"",
      "type": "text",
      "width": 260,
      "x": -340,
      "y": -400
    },
    {
      "height": 60,
      "id": "aec46a2d45740681",
      "styleAttributes": {
        "textAlign": "center"
      },
      "text": "Помощь в рождении души",
